# Security + cache headers — تُطبَّقها Cloudflare Workers على الأصول الثابتة.
# يجب أن يبقى هذا الملف داخل الأصول (لا يُستبعد في .assetsignore/.cfignore)
# ولا يُقدَّم كملف عام. راجع tests/central-hardening.test.cjs.

/js/*
  Cache-Control: public, max-age=300, must-revalidate
  X-Content-Type-Options: nosniff

/css/*
  Cache-Control: public, max-age=300, must-revalidate
  X-Content-Type-Options: nosniff

/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(self)

/favicon.svg
  Cache-Control: public, max-age=604800

/preview.png
  Cache-Control: public, max-age=604800

# الفيديو والغلاف: فيهما ?v=<بصمة> فالتخزين الطويل آمن — أي إعادة توليد
# بتغيّر البصمة وبالتالي الرابط.
# Accept-Ranges ضروري عشان المتصفح ينقّل (seek) جوه الفيديو بدل ما يحمّله كله.
/media/*
  Cache-Control: public, max-age=604800, immutable
  Accept-Ranges: bytes
  X-Content-Type-Options: nosniff

# HSTS: سنة كاملة. لا includeSubDomains ولا preload لأن النطاق
# workers.dev عام/مرحلي؛ أضفهما فقط بعد ربط نطاق نهائي تملكه.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(self)
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# config.js: لا يُخزَّن أبداً (حادثة 2026-11-06 — كاش قديم أعاد عنوان مشروع محذوف).
# قاعدة أخيرة عمداً: "! Cache-Control" يشيل أي قيمة ورثناها من /js/* أو /*.
/js/config.js
  ! Cache-Control
  Cache-Control: no-store
  X-Content-Type-Options: nosniff
